<div class="fallout-dialog forkout-roller">
	{{!-- The roll panel: the artwork (1748 x 969 px) with controls laid over it,
	      positioned in artwork pixels and scaled to the window by CSS. --}}
	<div class="fr-panel">
		<input type="hidden" name="attribute" value="{{attribute}}">
		<input type="hidden" name="skill" value="{{skill}}">
		<input type="hidden" name="complication" value="{{complication}}">
		<input type="checkbox" name="tag" class="fr-hidden" {{checked tag}}>

		{{!-- Rotary counters (strips filled in by Dialog2d20) --}}
		<div class="fr-dial fr-attribute" data-field="attribute" data-place="all"
			data-tooltip="{{localize 'FALLOUT.TEMPLATES.Attribute'}}"></div>
		<div class="fr-dial fr-skill" data-field="skill" data-place="all"
			data-tooltip="{{localize 'TYPES.Item.skill'}}"></div>
		<div class="fr-dial fr-comp-tens" data-field="complication" data-place="tens"
			data-tooltip="{{localize 'FALLOUT.TEMPLATES.Compl'}}"></div>
		<div class="fr-dial fr-comp-units" data-field="complication" data-place="units"
			data-tooltip="{{localize 'FALLOUT.TEMPLATES.Compl'}}"></div>

		{{!-- Plus / minus keys --}}
		<a class="fr-key fr-attribute-up" data-field="attribute" data-delta="1"></a>
		<a class="fr-key fr-attribute-down" data-field="attribute" data-delta="-1"></a>
		<a class="fr-key fr-skill-up" data-field="skill" data-delta="1"></a>
		<a class="fr-key fr-skill-down" data-field="skill" data-delta="-1"></a>
		<a class="fr-key fr-comp-up" data-field="complication" data-delta="1"></a>
		<a class="fr-key fr-comp-down" data-field="complication" data-delta="-1"></a>

		{{!-- Tag switch --}}
		<a class="fr-tag{{#if tag}} lit{{/if}}"><span class="fr-tag-light"></span></a>

		{{!-- Number of d20s --}}
		<a class="dice-icon d20 fr-hex fr-hex-1" data-index="1"></a>
		<a class="dice-icon d20 fr-hex fr-hex-2" data-index="2"></a>
		<a class="dice-icon d20 fr-hex fr-hex-3" data-index="3"></a>
		<a class="dice-icon d20 fr-hex fr-hex-4" data-index="4"></a>
		<a class="dice-icon d20 fr-hex fr-hex-5" data-index="5"></a>
		<a class="dice-icon d20 fr-hex fr-hex-6" data-index="6"></a>

		<a class="fr-roll"></a>
	</div>
</div>
