<form class="{{cssClass}} {{actor.type}} classic-sheet" autocomplete="off">

	{{> actor/classic/partials/frame }}

	{{!-- INFO SCREEN (bottom left) --}}
	<section class="classic-screen classic-screen-info" data-screen="info">
		<div class="classic-sweep" aria-hidden="true"></div>
		<div class="classic-zoom">
		<div class="classic-id">
			<input class="classic-origin" name="system.origin" type="text"
				placeholder="{{localize 'FALLOUT.TEMPLATES.Origin'}}"
				value="{{system.origin}}" data-dtype="String"/>
			{{!-- Game date, read-only; set by the GM in Date and Time --}}
			<div class="classic-date"></div>

			<div class="classic-stats">
				<div class="classic-stat">
					<label {{#if levelUp}}class="level-up-label fa-beat"{{/if}}>
						{{#if levelUp}}
							<a data-action="levelUp" data-tooltip="Click to Level Up">
								{{localize "FALLOUT.LEVEL.Level"}}
							</a>
						{{else}}
							{{localize "FALLOUT.LEVEL.Level"}}
						{{/if}}
					</label>
					<input data-dtype="Number" min="0" name="system.level.value"
						type="number" value="{{system.level.value}}"/>
				</div>

				<div class="classic-stat">
					<label>
						{{#if isPlayerCharacter}}
							<a class="availability-roll"
								data-tooltip="{{localize 'FALLOUT.AvailabilityRoll.tooltip'}}">
								<i class="fa-light fa-hand-fingers-crossed"></i>
							</a>
						{{/if}}
						{{localize "FALLOUT.TEMPLATES.Luck"}}
					</label>
					<input name="system.luckPoints" type="number"
						value="{{system.luckPoints}}" min="0">
				</div>

				<div class="classic-stat">
					<label>{{localize "FALLOUT.LEVEL.CurrentXP"}}</label>
					<input data-dtype="Number" name="system.level.currentXP"
						type="text" value="{{system.level.currentXP}}"/>
				</div>

				<div class="classic-stat">
					<label>{{localize "FALLOUT.LEVEL.NextXP"}}</label>
					<input data-dtype="Number" name="system.level.nextLevelXP"
						type="text" value="{{system.level.nextLevelXP}}"
						{{#unless disableAutoDerivedStats}}
							{{#unless disableAutoXpTarget}}
								data-tooltip="{{localize 'FALLOUT.Actor.Warnings.DerivedValue'}}"
								disabled
							{{/unless}}
						{{/unless}}
					/>
				</div>
			</div>
		</div>
		</div>
	</section>

	{{!-- MAIN SCREEN (right) --}}
	<section class="classic-screen classic-screen-main" data-screen="main">
		<div class="classic-sweep" aria-hidden="true"></div>
		<div class="classic-zoom">
		<div class="sheet-body">
			{{> actor/classic/tabs/pc-status }}
			{{> actor/pc/tabs/abilities }}
			{{> actor/pc/tabs/weapons }}
			{{> actor/pc/tabs/apparel }}
			{{> actor/classic/tabs/pc-inventory }}
			{{> actor/_shared-partials/data-tab }}
		</div>
		{{> actor/pc/partials/encumbrance }}
		</div>
	</section>

	<div class="classic-scanlines" aria-hidden="true"></div>
</form>
